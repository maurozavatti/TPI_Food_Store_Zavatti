# Conexión a PostgreSQL (crear antes la base vacía "foodstore_db" en pgAdmin)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/foodstore_db
# Alternativa sin PostgreSQL (solo desarrollo):
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar los JWT (mínimo 32 caracteres). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173